# Copy to .env.local and fill in. Never commit real values.
# Vercel: set the same variables in Project Settings -> Environment Variables.

# --- Clerk (auth) -------------------------------------------------------------
# From the Clerk dashboard -> API keys. Required at runtime.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
# Routes for Clerk's prebuilt components (match src/app/sign-in and sign-up).
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
# Where to send users after sign-in / sign-up when no redirect is requested.
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/app
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/app

# --- Database (Neon Postgres) -------------------------------------------------
# Pooled connection string, used by the app at runtime (Neon dashboard -> Connect).
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/abl?sslmode=require
# Direct (non-pooled) connection string, used by drizzle-kit for migrations.
# Optional: drizzle-kit falls back to DATABASE_URL if unset.
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-xxx.region.aws.neon.tech/abl?sslmode=require

# --- PostHog (product analytics) ----------------------------------------------
# Project token (Project settings -> Project token). Leave empty to disable analytics.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
# Ingestion host: https://us.i.posthog.com or https://eu.i.posthog.com
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# Comma-separated user IDs to mark as test users in PostHog (e.g. the e2e Clerk user)
POSTHOG_TEST_USER_IDS=

# --- AI providers (platform keys) ---------------------------------------------
# Server-only. A provider without a key can't serve platform-paid calls; users
# may still supply their own key (BYOK) for it.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# --- Inngest (background jobs for the specialists after discovery) -------------
# Local: set INNGEST_DEV=1 and run `pnpm inngest:dev` next to `pnpm dev`.
# Production: event and signing keys from the Inngest dashboard.
INNGEST_DEV=1
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# --- Test user (Clerk development instance only) ---------------------------
E2E_CLERK_USER_USERNAME=
E2E_CLERK_USER_PASSWORD=

# Reminder emails (Resend). Without RESEND_API_KEY, reminders run the coach at
# the learner's time but send no email.
RESEND_API_KEY=
# The From address; its domain must be verified in Resend.
REMINDER_FROM=ABL <hello@iamabl.com>
# A long random string that signs one-click unsubscribe links.
REMINDER_SECRET=
# The site's public URL, for links in emails.
APP_URL=https://iamabl.com
